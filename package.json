{
  "name": "binding-casos-exito",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --mode revision --host 127.0.0.1",
    "dev:borradores": "astro dev --mode borradores --host 127.0.0.1",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "build": "astro build --mode production",
    "build:revision": "astro build --mode revision --outDir dist-revision",
    "preview": "astro preview --host 127.0.0.1",
    "preview:revision": "astro preview --host 127.0.0.1 --outDir dist-revision",
    "test": "playwright test",
    "test:contenido": "node --test tests/content.test.mjs",
    "test:plantilla": "node scripts/prueba-plantilla.mjs",
    "verify": "pnpm check && pnpm typecheck && pnpm build && pnpm build:revision && pnpm test:contenido && pnpm test && pnpm test:plantilla && pnpm test:modular",
    "test:modular": "node scripts/prueba-modular.mjs",
    "build:modular": "node scripts/prueba-modular.mjs --solo-revision"
  },
  "dependencies": {
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
