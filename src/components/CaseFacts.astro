---
import { languageFromPath, ui } from '../data/languages';
const t = ui(languageFromPath(Astro.url.pathname));
import CaseImage from './CaseImage.astro';
import type { CaseData } from '../lib/cases';

interface Props { data: CaseData }

const { data } = Astro.props;
const { facts, sector, location, solutions } = data;
const values = [
  [t.location, location],
  [t.sector, sector],
  [t.establishment, facts?.establishment],
  [t.rooms, facts?.rooms],
  [t.solutions, solutions?.join(', ')],
  [t.implemented, facts?.implementedOn],
].filter(([, value]) => value !== undefined);
---

{(values.length > 0 || facts?.logo || facts?.website) && (
  <section class="case-facts" aria-labelledby="case-facts-title">
    <h2 id="case-facts-title">{t.facts}</h2>
    {facts?.logo && <div class="case-logo"><CaseImage image={facts.logo} /></div>}
    {values.length > 0 && (
      <dl>
        {values.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    )}
    {facts?.website && <a class="text-link" href={facts.website}>{t.website} {data.client} <span aria-hidden="true">↗</span></a>}
  </section>
)}
