---
import { caseMediaUrl } from '../data/site';
import type { CaseImage } from '../lib/cases';

interface Props {
  image: CaseImage;
  eager?: boolean;
  sizes?: string;
}

const { image, eager = false, sizes = '(min-width: 78rem) 1168px, 92vw' } = Astro.props;
const { file, alt, width, height, small, focal, focalMobile } = image;
const positions = { centro: 'center', arriba: 'top', abajo: 'bottom', izquierda: 'left', derecha: 'right' };
const srcset = small && [
  caseMediaUrl(small.file) + ' ' + small.width + 'w',
  caseMediaUrl(file) + ' ' + width + 'w',
].join(', ');
---

<img
  style={{
    '--case-focal-desktop': positions[focal ?? 'centro'],
    '--case-focal-mobile': positions[focalMobile ?? focal ?? 'centro'],
    objectPosition: 'var(--case-focal-current, var(--case-focal-desktop))',
  }}
  src={caseMediaUrl(file)}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>



