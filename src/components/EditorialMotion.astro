<script>
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  const targets = document.querySelectorAll<HTMLElement>('[data-editorial-enter]');

  // A one-shot entry is shared across engines. Scroll-driven timelines can rewind.
  if (targets.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);

        // A link reached by keyboard retains its position and focus ring.
        if (!entry.target.matches(':focus-within')) {
          entry.target.classList.add('has-entered');
        }
      }
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.08 });

    targets.forEach((element) => {
      const settle = () => {
        element.classList.add('entry-settled');
        observer.unobserve(element);
      };
      element.addEventListener('focusin', settle, { once: true });
      element.addEventListener('animationend', (event) => {
        if (event.target === element && event.animationName === 'editorial-reveal') settle();
      });
    });

    const update = () => {
      observer.disconnect();
      if (preference.matches) {
        targets.forEach((element) => {
          if (element.classList.contains('has-entered')) element.classList.add('entry-settled');
        });
        return;
      }
      targets.forEach((element) => {
        if (!element.matches('.has-entered, .entry-settled')) observer.observe(element);
      });
    };
    preference.addEventListener('change', update);
    update();
  }
</script>


