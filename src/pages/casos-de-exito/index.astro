---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CorporateHero from '../../components/CorporateHero.astro';
import CorporateCTA from '../../components/CorporateCTA.astro';
import photo from '../../assets/corporate/hospitalidad.webp';
import mobilePhoto from '../../assets/corporate/hospitalidad-movil.webp';
import CaseCard from '../../components/CaseCard.astro';
import FeaturedCase from '../../components/FeaturedCase.astro';
import { site } from '../../data/site';
import { visibleCases } from '../../lib/cases';

const entries = await visibleCases();
const featured = entries.find(({ data }) => data.status === 'publicado' && data.featured)
  ?? entries.find(({ data }) => data.featured);
const listed = entries.filter((entry) => entry !== featured);
---

<BaseLayout
  title="Casos de éxito | Binding Software"
  description="Experiencias de establecimientos hoteleros con las soluciones de Binding Software."
>
  <CorporateHero
    eyebrow="Tecnología en la operativa hotelera"
    title="Casos de éxito"
    summary="Cómo los equipos hoteleros conectan sus sistemas y simplifican la llegada del huésped con Binding."
  >
    <picture slot="media">
      <source media="(max-width: 44rem)" srcset={mobilePhoto.src} />
      <Image src={photo} alt="" loading="eager" fetchpriority="high" />
    </picture>
  </CorporateHero>
  <div class="container catalog section">
    {featured && <FeaturedCase entry={featured} />}
    {listed.length > 0 && (
      <section class="catalog-list" aria-labelledby="catalog-title">
        <h2 id="catalog-title">{featured ? 'Más casos de éxito' : 'Historias de clientes'}</h2>
        <ul class="case-grid" role="list">
          {listed.map((entry) => <li data-editorial-enter><CaseCard entry={entry} /></li>)}
        </ul>
      </section>
    )}
    {entries.length === 0 && (
      <section class="catalog-empty" aria-labelledby="empty-title">
        <h2 id="empty-title">Los casos se publicarán aquí</h2>
        <p>El catálogo todavía está a la espera de las primeras historias aprobadas.</p>
      </section>
    )}
  </div>
  <section class="cases-contact section" aria-labelledby="contact-title">
    <div class="container cases-contact-inner">
      <div>
        <h2 id="contact-title">Hablemos de la operativa de tu hotel</h2>
        <p>Cuéntanos cómo gestionas el check-in y qué procesos quieres conectar.</p>
      </div>
      <CorporateCTA href={site.contact}>Contactar con Binding</CorporateCTA>
    </div>
  </section>
</BaseLayout>




