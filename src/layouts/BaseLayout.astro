---
import Header from '../components/Header.astro';
import EditorialMotion from '../components/EditorialMotion.astro';
import Footer from '../components/Footer.astro';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { isReview } from '../lib/cases';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/cases.css';

interface Props {
  title: string;
  description: string;
  kind?: 'article' | 'website';
  image?: { url: string; alt: string };
}

const { title, description, kind = 'website', image } = Astro.props;
const canonical = !isReview && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = canonical && image ? new URL(image.url, canonical).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#21172b" />
    {isReview && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={kind} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImage && image && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:alt" content={image.alt} />
    </>}
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/png" href="/assets/branding/favicon.png" />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <EditorialMotion />
  </body>
</html>


